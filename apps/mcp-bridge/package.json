{
  "name": "@co-canvas/mcp-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Per-harness MCP server exposing co-canvas rooms over stdio",
  "exports": {
    ".": "./src/index.ts",
    "./dist/main.js": "./dist/main.js"
  },
  "bin": {
    "co-canvas-mcp": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown && node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fractional-indexing": "^3.2.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@co-canvas/hub": "workspace:*",
    "@co-canvas/hub-client": "workspace:*",
    "@co-canvas/protocol": "workspace:*",
    "@excalidraw/excalidraw": "0.18.1",
    "@types/node": "^26.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14"
  }
}
