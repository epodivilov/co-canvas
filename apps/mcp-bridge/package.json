{
  "name": "@co-canvas/mcp-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Per-harness MCP server exposing co-canvas rooms over stdio",
  "bin": {
    "co-canvas-mcp": "./dist/main.js"
  },
  "files": [
    "dist"
