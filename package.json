{
  "name": "@co-canvas/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared live whiteboard for AI agents and humans",
  "license": "MIT",
  "author": "Evgenii Podivilov",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @co-canvas/web build && pnpm --filter @co-canvas/mcp-bridge build && pnpm --filter @co-canvas/hub-cli build && pnpm --filter co-canvas build",
    "build:binary": "pnpm --filter @co-canvas/web build && pnpm --filter @co-canvas/hub-cli build:binary",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @co-canvas/web test:e2e",
    "check": "biome check . && pnpm -r typecheck && pnpm test",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.2",
    "jsdom": "^28.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "y-excalidraw>@excalidraw/excalidraw": "*"
      }
    }
  }
}
